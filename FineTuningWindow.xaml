<Window x:Class="OverlayPic.FineTuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OverlayPic - Fine Tuning"
        Width="175"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseWheel="Window_MouseWheel"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="JogBtn" TargetType="Button">
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#66000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#99000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F20F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="10" Padding="8,8" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.6" />
        </Border.Effect>
        <StackPanel>
            <!-- Header (Draggable) -->
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯" FontSize="11" Margin="0,0,4,0" />
                    <TextBlock x:Name="TitleText" Text="미세 정렬" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StepBtn" Content="1px" FontSize="9" FontWeight="Bold" Padding="5,1" 
                            Background="#334155" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" 
                            Click="Step_Click" ToolTip="이동 단위 변경 (1px / 10px)" Margin="0,0,4,0" />
                    <Button Content="✕" FontSize="10" FontWeight="Bold" Width="18" Height="18" 
                            Background="#334155" Foreground="#CBD5E1" BorderThickness="0" Cursor="Hand" 
                            Click="Close_Click" ToolTip="닫기 (Esc)" />
                </StackPanel>
            </Grid>

            <!-- D-Pad (Position Nudge) -->
            <Grid HorizontalAlignment="Center" Margin="0,2,0,6" Width="84" Height="84">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>

                <!-- Up -->
                <Button x:Name="UpBtn" Grid.Row="0" Grid.Column="1" Content="▲" 
                        Style="{StaticResource JogBtn}" Width="24" Height="24" FontSize="10" Click="Up_Click" ToolTip="위로 이동 (↑)" />
                <!-- Left -->
                <Button x:Name="LeftBtn" Grid.Row="1" Grid.Column="0" Content="◀" 
                        Style="{StaticResource JogBtn}" Width="24" Height="24" FontSize="10" Click="Left_Click" ToolTip="왼쪽으로 이동 (←)" />
                <!-- Center Indicator -->
                <Border Grid.Row="1" Grid.Column="1" Background="#1E293B" CornerRadius="4" Width="24" Height="24" Cursor="Hand" MouseLeftButtonDown="Step_Click">
                    <TextBlock x:Name="CenterStepText" Text="1px" FontSize="8" FontWeight="Bold" Foreground="#94A3B8" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Right -->
                <Button x:Name="RightBtn" Grid.Row="1" Grid.Column="2" Content="▶" 
                        Style="{StaticResource JogBtn}" Width="24" Height="24" FontSize="10" Click="Right_Click" ToolTip="오른쪽으로 이동 (→)" />
                <!-- Down -->
                <Button x:Name="DownBtn" Grid.Row="2" Grid.Column="1" Content="▼" 
                        Style="{StaticResource JogBtn}" Width="24" Height="24" FontSize="10" Click="Down_Click" ToolTip="아래로 이동 (↓)" />
            </Grid>

            <!-- Size Adjusters (Width / Height) -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Width +/- -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="W" FontSize="9" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,3,0" />
                    <Button Content="-" Style="{StaticResource JogBtn}" Width="18" Height="18" FontSize="10" Click="WidthMinus_Click" ToolTip="가로 축소 (Ctrl+←)" />
                    <Button Content="+" Style="{StaticResource JogBtn}" Width="18" Height="18" FontSize="10" Click="WidthPlus_Click" Margin="2,0,0,0" ToolTip="가로 확대 (Ctrl+→)" />
                </StackPanel>
                <!-- Height +/- -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="H" FontSize="9" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,3,0" />
                    <Button Content="-" Style="{StaticResource JogBtn}" Width="18" Height="18" FontSize="10" Click="HeightMinus_Click" ToolTip="세로 축소 (Ctrl+↑)" />
                    <Button Content="+" Style="{StaticResource JogBtn}" Width="18" Height="18" FontSize="10" Click="HeightPlus_Click" Margin="2,0,0,0" ToolTip="세로 확대 (Ctrl+↓)" />
                </StackPanel>
            </Grid>

            <!-- Coordinates & Size Text -->
            <Border Background="#1E293B" CornerRadius="4" Padding="4,3" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock x:Name="PosText" Text="X: 0   Y: 0" FontSize="9" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SizeText" Text="W: 800  H: 600" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,1,0,0" />
                </StackPanel>
            </Border>

            <!-- Wheel Hint -->
            <TextBlock x:Name="HintText" Text="휠: Y이동  |  Shift+휠: X이동" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
