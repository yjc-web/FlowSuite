<Window x:Class="OverlayPic.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Grid x:Name="RootCanvas">
        <!-- Background Screen Snapshot -->
        <Image x:Name="BackgroundImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Dark Dim Mask Overlay -->
        <Border Background="#77000000" />

        <!-- Snip Selection Highlight (Transparent window into the bright snapshot) -->
        <Canvas>
            <!-- Selection Border & Fill -->
            <Border x:Name="SelectionBox" BorderBrush="#38BDF8" BorderThickness="2" Background="Transparent" Visibility="Collapsed">
                <Grid>
                    <!-- Size Badge in the selection -->
                    <Border Background="#D90F172A" CornerRadius="4" Padding="6,3" 
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4">
                        <TextBlock x:Name="SizeLabel" Text="0 × 0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                    </Border>
                </Grid>
            </Border>

            <!-- Guide Hint Banner -->
            <Border x:Name="HintBanner" 
                    Background="#EE0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HintMainText" Text="✂️ 캡처할 영역을 드래그하세요" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,12,0" />
                    <TextBlock x:Name="HintSubText" Text="(취소: Esc / 마우스 우클릭)" FontSize="12" Foreground="#94A3B8" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
