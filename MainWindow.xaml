<Window x:Class="OverlayPic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OverlayPic — 화면 오버레이 투명 뷰어" 
        Width="520" Height="420"
        MinWidth="180" MinHeight="140"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Icon="Resources/app.ico"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="BarBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#66000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#99000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="BarToggle" TargetType="Primitives:ToggleButton" xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Primitives:ToggleButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CC2563EB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#66000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Dark Theme ContextMenu Style (Removes default white gutter) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="6" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme MenuItem Style -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="2,0,4,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme Separator Style -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Height" Value="1" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
        <!-- Checkerboard Background -->
        <Border x:Name="CheckerBorder" CornerRadius="8" ClipToBounds="True" Visibility="Collapsed">
            <Border.Background>
                <DrawingBrush Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#E2E8F0">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,16,16" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#CBD5E1">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,8,8" />
                                        <RectangleGeometry Rect="8,8,8,8" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>

        <!-- Initial Drop Zone (when no image loaded) -->
        <Border x:Name="DropZone" CornerRadius="8" Background="#EE0F172A" BorderBrush="#3B82F6" BorderThickness="2"
                Cursor="Hand" MouseLeftButtonDown="DropZone_MouseLeftButtonDown">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="DropIcon" Text="📌" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="DropTitle" Text="이미지를 여기에 드래그 &amp; 드롭" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center" />
                <TextBlock x:Name="DropSubtitle" Text="또는 붙여넣기 (Ctrl+V)  |  화면 캡처해서 바로 넣기 (Ctrl+Alt+X)" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock x:Name="DropHint" Text="마우스 휠: 투명도 조절  |  Ctrl+휠: 창 크기 조절  |  클릭하여 파일 열기" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- The Image Display -->
        <Border CornerRadius="8" ClipToBounds="True">
            <Image x:Name="OverlayImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <!-- Subtle outline border (helps locate transparent images) -->
        <Border x:Name="OutlineBorder" CornerRadius="8" BorderBrush="#663B82F6" BorderThickness="1.5" IsHitTestVisible="False" />

        <!-- Floating Top Control Bar (auto-translucent) -->
        <Border x:Name="ControlBar" 
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#D90F172A" CornerRadius="8,8,0,0"
                Padding="8,5" Cursor="SizeAll"
                MouseLeftButtonDown="ControlBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Opacity slider & Percentage -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DragHintIcon" Text="⊞" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,6,0" ToolTip="드래그하여 창 이동" />
                    <TextBlock x:Name="OpacityTitle" Text="투명도:" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider x:Name="OpacitySlider" Width="90" Minimum="0.05" Maximum="1.0" Value="1.0" 
                            VerticalAlignment="Center" Cursor="Hand"
                            ValueChanged="OpacitySlider_ValueChanged"
                            ToolTip="투명도 조절 (마우스 휠로도 가능)" />
                    <TextBlock x:Name="OpacityLabel" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" 
                               VerticalAlignment="Center" Margin="4,0,0,0" Width="36" />
                </StackPanel>

                <!-- Center: Info text -->
                <TextBlock x:Name="InfoLabel" Grid.Column="1" 
                           FontSize="10" Foreground="#94A3B8"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="6,0" />

                <!-- Right: Action Buttons (Minimal 5 Icons) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1. Click-Through Toggle -->
                    <Primitives:ToggleButton x:Name="ClickThroughToggle" xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                             Content="👆" Style="{StaticResource BarToggle}" 
                                             ToolTip="클릭 통과 모드 (뒤쪽 프로그램 클릭 가능 / 해제: Esc 또는 Ctrl+Shift+T)" Margin="0,0,3,0"
                                             Checked="ClickThrough_Changed" Unchecked="ClickThrough_Changed" />
                    
                    <!-- 1-1. Fine Tuning (Jog) Toggle -->
                    <Primitives:ToggleButton x:Name="JogModeToggle" xmlns:Primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                                             Content="🎯" Style="{StaticResource BarToggle}" 
                                             ToolTip="🎯 미세 정렬 모드 (방향키 1px 이동, 조그 패드)" Margin="0,0,3,0"
                                             Checked="JogMode_Changed" Unchecked="JogMode_Changed" />

                    <!-- 2. Screen Snip -->
                    <Button x:Name="SnipBtn" Content="✂" Style="{StaticResource BarBtn}" Click="Snip_Click" 
                            ToolTip="화면 영역 드래그 캡처 (Ctrl+Alt+X)" Margin="0,0,3,0" />

                    <!-- 3. More Menu (...) -->
                    <Button x:Name="MoreBtn" Content="⋯" Style="{StaticResource BarBtn}" Click="More_Click" 
                            ToolTip="더보기 메뉴 (Ctrl+O, Ctrl+V, 고정, 설정 등)" Margin="0,0,3,0">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MainMenu">
                                <MenuItem x:Name="MenuOpen" Header="📂 이미지 파일 열기... (Ctrl+O)" Click="Open_Click" />
                                <MenuItem x:Name="MenuSave" Header="💾 이미지 다른 이름으로 저장... (Ctrl+S)" Click="Save_Click" />
                                <MenuItem x:Name="MenuPaste" Header="📋 클립보드 붙여넣기 (Ctrl+V)" Click="Paste_Click" />
                                <Separator />
                                <MenuItem x:Name="MenuJog" Header="🎯 미세 정렬 모드 (방향키 1px)" IsCheckable="True" Click="MenuJog_Click" />
                                <MenuItem x:Name="MenuLock" Header="🔒 위치 및 크기 고정 (Ctrl+L)" IsCheckable="True" Click="MenuLock_Click" />
                                <MenuItem x:Name="MenuChecker" Header="🏁 체커보드 배경 토글 (Space)" IsCheckable="True" Click="MenuChecker_Click" />
                                <MenuItem x:Name="MenuReset" Header="↻ 1:1 원본 해상도로 리셋 (Ctrl+R)" Click="ResetSize_Click" />
                                <Separator />
                                <MenuItem x:Name="MenuLang" Header="🌐 Language / 언어 전환 (English ↔ 한국어)" Click="Lang_Click" Foreground="#38BDF8" FontWeight="SemiBold" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- 4. About / Donation Info -->
                    <Button x:Name="AboutBtn" Content="ℹ" Style="{StaticResource BarBtn}" Click="About_Click" 
                            ToolTip="프로그램 정보 / 후원 / 단축키 안내" Margin="0,0,3,0" />

                    <!-- 5. Minimize -->
                    <Button x:Name="MinimizeBtn" Content="─" Style="{StaticResource BarBtn}" Click="Minimize_Click" 
                            ToolTip="최소화 (Ctrl+M)" Margin="0,0,3,0" />

                    <!-- 6. Close -->
                    <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource BarBtn}" Click="Close_Click" 
                            ToolTip="닫기 (Esc)" Background="#88EF4444" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- About & Shortcut Info Modal Layer (2-Column All-in-One Layout) -->
        <Border x:Name="AboutModal" Background="#E60F172A" CornerRadius="8" Visibility="Collapsed" 
                Padding="12" MouseLeftButtonDown="AboutModal_BackgroundClick">
            <Border Background="#1E293B" CornerRadius="8" BorderBrush="#3B82F6" BorderThickness="1.5"
                    MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="14" MouseLeftButtonDown="AboutModal_InnerClick">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Title & Header with Close Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AboutHeaderTitle" Text="📌 OverlayPic v1.0" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock x:Name="AboutSubtitle" Text="화면 오버레이 투명 뷰어 | Made by YJC" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="24" Height="24" Background="#334155" Foreground="#CBD5E1"
                                BorderThickness="0" Cursor="Hand" Click="CloseAbout_Click" ToolTip="닫기 (Esc)">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- 2-Column Content Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Shortcuts List -->
                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                            <StackPanel x:Name="ShortcutsStackPanel">
                                <TextBlock x:Name="ShortcutsTitle" Text="⌨️ 주요 단축키" FontWeight="Bold" FontSize="11" Foreground="#F1F5F9" Margin="0,0,0,6" />
                                <TextBlock x:Name="ShortcutSnip" Text="• Ctrl+Alt+X : ✂️ 화면 영역 드래그 캡처" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutJog" Text="• 🎯 미세 정렬 : 방향키(1px 이동), Ctrl+방향키(1px 크기)" FontSize="10.5" Foreground="#38BDF8" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutSave" Text="• Ctrl+S : 💾 현재 이미지 파일로 저장" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutOpen" Text="• Ctrl+O : 📂 이미지 파일 열기" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutPaste" Text="• Ctrl+V : 📋 클립보드 이미지/파일 붙여넣기" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutToggle" Text="• Ctrl+Shift+T / Ctrl+T : 클릭 통과 토글" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutEsc" Text="• Esc : 클릭 통과 해제 (일반 시 창 닫기)" FontSize="10.5" Foreground="#F59E0B" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutMin" Text="• Ctrl+M : 최소화 (Minimize)" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutOpacity" Text="• 마우스 휠 / +, - : 투명도 조절" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutResize" Text="• Ctrl + 휠 / Ctrl+(+,-) : 창 크기 조절" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutLock" Text="• Ctrl+L : 위치/크기 고정 토글" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutReset" Text="• Ctrl+R : 원본 해상도 크기로 리셋" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                                <TextBlock x:Name="ShortcutSpace" Text="• Space : 체커보드 배경 토글" FontSize="10.5" Foreground="#CBD5E1" Margin="0,1.5" />
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Blog/GitHub & Dual Donation Cards (KR / EN) -->
                        <StackPanel Grid.Column="1">
                            <!-- Website / GitHub Button -->
                            <Button x:Name="BlogBtn" Content="🌐 공식 블로그 방문 (nds-macro)" 
                                    Background="#2563EB" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                    Padding="6,5" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"
                                    Click="OpenBlog_Click" ToolTip="https://blog.naver.com/nds-macro">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- 1. Korean Donation Card (KakaoPay QR) -->
                            <Border x:Name="KakaoPayCard" Background="#0F172A" CornerRadius="6" Padding="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="DonationTitle" Text="☕ 커피 한 잔 후원 (카카오페이)" FontWeight="Bold" FontSize="10.5" Foreground="#FCD34D" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <Border Background="White" CornerRadius="6" HorizontalAlignment="Center" Padding="5" Width="105" Height="105">
                                        <Image Source="Resources/kakaopay_qr.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock x:Name="DonationSubtitle" Text="카카오페이 앱으로 QR 스캔" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 2. Global Donation Card (Buy Me a Coffee / GitHub) -->
                            <Border x:Name="GlobalCoffeeCard" Background="#0F172A" CornerRadius="6" Padding="10" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="☕ Support the Developer" FontWeight="Bold" FontSize="11" Foreground="#FFDD00" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    
                                    <!-- Buy Me a Coffee Button -->
                                    <Button Background="#FFDD00" Foreground="#000000" FontWeight="Bold" FontSize="11.5"
                                            Padding="10,7" BorderThickness="0" Cursor="Hand" Width="160" Margin="0,0,0,8"
                                            Click="BuyCoffee_Click" ToolTip="https://buymeacoffee.com/flowsuiteyjc">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="☕ " FontSize="12" />
                                            <TextBlock Text="Buy me a coffee" FontWeight="Bold" />
                                        </StackPanel>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- GitHub Star Button -->
                                    <Button Background="#334155" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="10.5"
                                            Padding="8,5" BorderThickness="0" Cursor="Hand" Width="160"
                                            Click="OpenGitHub_Click" ToolTip="https://github.com/yjc-web/FlowSuite">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⭐ " FontSize="11" Foreground="#FCD34D" />
                                            <TextBlock Text="Star on GitHub" />
                                        </StackPanel>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    
                                    <TextBlock Text="Card, Apple Pay, Google Pay" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
